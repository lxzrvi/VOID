<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Void" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/void_white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Launch theme: brand red with the mark, swapped for Theme.Void in onCreate. -->
    <style name="Theme.Void.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/void_red</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Void</item>
    </style>
</resources>
